# Para ligar o Claude: copie este arquivo com o nome .env e cole sua chave abaixo.
# Sem chave, a Concilia funciona com a leitura local (OCR + regras).
ANTHROPIC_API_KEY=
# Senhas das contas de demonstração (valem quando o banco é criado)
CONCILIA_SENHA_ADMIN=
CONCILIA_SENHA_REVISOR=
CONCILIA_SENHA_OPERADOR=
# Opcional: outro modelo (o padrão é claude-opus-5-5)
# CONCILIA_MODELO=claude-opus-5-5

# Contas: limite de documentos por conta (somando os workspaces) e cadastro de empresas pela tela de login (0 desliga)
CONCILIA_LIMITE_DOCUMENTOS=100000
CONCILIA_CADASTRO_ABERTO=1

# Banco: sem DATABASE_URL usa SQLite (dados/concilia.db). Para o Supabase, use o Session pooler (ver docs/SUPABASE.md)
# DATABASE_URL=postgresql://postgres.<projeto>:SUA-SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
